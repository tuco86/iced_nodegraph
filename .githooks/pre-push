#!/usr/bin/env bash
# Full gate: mirror the CI `test` job plus the AGENTS.md wasm check, so a push
# that would go red on CI fails locally first. Slow by design (clippy + tests).
set -euo pipefail

echo "pre-push: cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "pre-push: cargo clippy -p iced_nodegraph -p iced_nodegraph_sdf --all-targets -- -D warnings"
cargo clippy -p iced_nodegraph -p iced_nodegraph_sdf --all-targets -- -D warnings

# `iced_test::Simulator` leaks a headless renderer per instance; on the GPU
# backend the 49 simulator tests exhaust the device. They assert messages,
# not pixels, so run the package on the CPU backend.
echo "pre-push: ICED_TEST_BACKEND=tiny-skia cargo test -p iced_nodegraph"
ICED_TEST_BACKEND=tiny-skia cargo test -p iced_nodegraph

# The orbit search-quality sweep, ignored by default so it stays off the inner
# loop (it alone was 93% of the lib suite's wall time).
echo "pre-push: cargo test -p iced_nodegraph --lib -- --ignored"
cargo test -p iced_nodegraph --lib -- --ignored

# The SDF pixel tests each spin up a full wgpu device; serialize them like CI.
echo "pre-push: cargo test -p iced_nodegraph_sdf -- --test-threads=1"
cargo test -p iced_nodegraph_sdf -- --test-threads=1

echo "pre-push: cargo check --workspace"
cargo check --workspace

echo "pre-push: cargo check -p iced_nodegraph_bench --benches"
cargo check -p iced_nodegraph_bench --benches

# WASM compilation is checked locally only (CI is native-only).
if rustup target list --installed 2>/dev/null | grep -qx wasm32-unknown-unknown; then
    echo "pre-push: cargo check -p iced_nodegraph --target wasm32-unknown-unknown"
    cargo check -p iced_nodegraph --target wasm32-unknown-unknown
else
    echo "pre-push: skipping wasm check (target wasm32-unknown-unknown not installed)"
fi
